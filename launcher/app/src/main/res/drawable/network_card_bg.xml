<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#253B50" android:endColor="#142232" android:angle="315" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#66D9EF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#202B3B" android:endColor="#101620" android:angle="315" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#374D68" />
        </shape>
    </item>
</selector>
